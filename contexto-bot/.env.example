# You don't need to create this by hand: the first start asks for the token and
# writes .env for you. On a hosting service, set these as environment variables.
DISCORD_TOKEN=

# Public links shown on the bot's Terms / Privacy buttons (see docs/ and the README).
TERMS_URL=
PRIVACY_URL=

# Optional: where the SQLite database lives (default: contexto.db next to bot.py).
DATABASE_PATH=

# The dev server is not set here. The bot owner runs `@Contexto devguild set` in Discord.
